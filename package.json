{
  "name": "claude-code-realtime-apps",
  "version": "1.0.0",
  "description": "Real-time applications with WebSocket, SSE, WebRTC. Chat, collaboration, live updates. Redis scaling, offline-first. Production examples with Claude Code.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "test": "npm run test:server && npm run test:client",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test",
    "test:load": "k6 run tests/load/websocket-load-test.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "keywords": [
    "realtime",
    "websocket",
    "webrtc",
    "server-sent-events",
    "socket-io",
    "redis",
    "chat-application",
    "collaboration",
    "live-updates",
    "offline-first",
    "real-time-communication",
    "claude-code",
    "nodejs",
    "scaling",
    "hermetic-technology"
  ],
  "author": "Hermetic Ormus",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "workspaces": [
    "server",
    "client",
    "shared"
  ]
}
